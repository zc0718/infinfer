{
  "id": "qemu-m7-an500",
  "qemu": "qemu-system-arm",
  "machine": "mps2-an500",
  "cpu": "cortex-m7",
  "load": "raw",
  "exit": "semihost-sys-exit",
  "timeout_s": 20,
  "toolchain": {
    "triplet": "arm-none-eabi",
    "package": "arm-toolchain/11.3.rel1",
    "version_probe": "11.3"
  },
  "hardware_ref": [
    "baremetal-cortex-m7"
  ],
  "tier": {
    "name": "arm_m",
    "claims": [
      "base"
    ],
    "why": "Cortex-M7 has the DSP extension the arm_m bodies use; -mcpu=cortex-m7 is already the build flag"
  }
}
